<Window x:Class="ProductionTranscription.App.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Production Transcription — Settings" Width="850" Height="660"
 MinWidth="480" MinHeight="360" Background="#141A22" Foreground="#F2F5FA"
 WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F2F5FA"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Foreground" Value="#17202B"/><Setter Property="Background" Value="#FFFFFF"/></Style>
 </Window.Resources>
 <DockPanel Margin="18">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="AUDIO &amp; SOURCE SETTINGS" FontSize="20" FontWeight="SemiBold"/>
   <TextBlock Text="v0.3 — Offline CPU transcription preview" Margin="0,6,0,16" Foreground="#A0B0C0"/>
   <WrapPanel Margin="0,0,0,12">
    <StackPanel Margin="0,0,15,10">
     <TextBlock Text="Audio backend" Margin="0,0,0,5"/>
     <ComboBox x:Name="BackendBox" Width="145" SelectionChanged="SettingsChanged">
      <ComboBoxItem Content="ASIO"/>
      <ComboBoxItem Content="WDM / WASAPI"/>
     </ComboBox>
    </StackPanel>
    <StackPanel Margin="0,0,15,10">
     <TextBlock Text="Default AI profile" Margin="0,0,0,5"/>
     <ComboBox x:Name="ProfileBox" Width="155" SelectionChanged="SettingsChanged">
      <ComboBoxItem Content="Speed First"/>
      <ComboBoxItem Content="Balanced"/>
      <ComboBoxItem Content="Accuracy First"/>
     </ComboBox>
    </StackPanel>
    <StackPanel Margin="0,0,15,10">
     <TextBlock Text="Audio input device" Margin="0,0,0,5"/>
     <DockPanel>
      <Button DockPanel.Dock="Right" Content="Refresh" Padding="8,2" Margin="5,0,0,0" Click="RefreshDevicesClicked"/>
      <ComboBox x:Name="DeviceBox" Width="270" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="DeviceSelectionChanged" Foreground="#17202B" Background="White"/>
     </DockPanel>
    </StackPanel>
   </WrapPanel>
   <WrapPanel Margin="0,0,0,8">
    <Button x:Name="StartCaptureButton" Content="Start capture" Click="StartCaptureClicked" Padding="12,6" Margin="0,0,8,0"/>
    <Button x:Name="StopCaptureButton" Content="Stop" Click="StopCaptureClicked" Padding="12,6" Margin="0,0,8,0" IsEnabled="False"/>
   </WrapPanel>
   <TextBlock x:Name="DeviceStatus" Text="Scanning devices..." Foreground="#A0B0C0" Margin="0,0,0,12" TextWrapping="Wrap"/>
   <DockPanel Margin="0,0,0,10">
    <Button DockPanel.Dock="Right" Content="+ Add source" Padding="10,5" Click="AddSourceClicked"/>
    <TextBlock Text="Transcription source mapping" FontSize="17" FontWeight="SemiBold"/>
   </DockPanel>
  </StackPanel>
  <TextBlock DockPanel.Dock="Bottom" Foreground="#A0B0C0" Margin="0,10,0,0"
    x:Name="CaptureStatus" Text="Capture inactive • Live audio levels will appear after Start capture"/>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <ItemsControl x:Name="SourcesList">
    <ItemsControl.ItemTemplate>
     <DataTemplate>
      <Border Margin="0,0,0,7" Padding="12" Background="#222C39" CornerRadius="8">
       <StackPanel>
        <WrapPanel>
        <CheckBox Content="On" IsChecked="{Binding Source.Enabled, Mode=TwoWay}"
          Margin="0,7,12,0" Checked="SourceChanged" Unchecked="SourceChanged"/>
        <TextBox Width="195" Text="{Binding Source.Name, UpdateSourceTrigger=PropertyChanged}" TextChanged="SourceChanged"/>
        <TextBlock Text="Input #" VerticalAlignment="Center" Margin="8,0,8,0"/>
        <TextBox Width="55" Text="{Binding Source.InputNumber, Mode=OneWay}"
          TextChanged="SourceInputTextChanged" LostFocus="SourceInputLostFocus"/>
        <Button Content="Remove source" Tag="{Binding Source}" Margin="15,0,0,0"
          Padding="8,4" Click="RemoveSourceClicked"/>
        </WrapPanel>
        <TextBlock Text="{Binding ValidationMessage}" Foreground="#FF7777" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
        <DockPanel Margin="0,8,0,0">
         <TextBlock DockPanel.Dock="Left" Text="Digital gain" Width="85" VerticalAlignment="Center"/>
         <TextBlock DockPanel.Dock="Right" Text="{Binding Source.GainDb, StringFormat={}{0:+0;-0;0} dB}" Width="62" TextAlignment="Right" VerticalAlignment="Center"/>
         <Slider Minimum="-24" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
           Value="{Binding Source.GainDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="GainChanged"/>
        </DockPanel>
       <ProgressBar Minimum="0" Maximum="100" Value="{Binding Level}" Height="9" Margin="0,10,0,0" Foreground="#33C5A8" Background="#0F1720"/>
       </StackPanel>
      </Border>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
 </DockPanel>
</Window>

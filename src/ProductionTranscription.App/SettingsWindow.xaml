<Window x:Class="ProductionTranscription.App.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Production Transcription — Settings" Width="1280" Height="800"
 MinWidth="1000" MinHeight="560" Background="#0B1019" Foreground="#F2F5FA"
 WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F0F5FC"/></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="0,0,8,0"/></Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0,0,10,0"/></Style>
 </Window.Resources>

 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,16">
   <TextBlock Text="Workspace settings" FontSize="27" FontWeight="SemiBold"/>
   <TextBlock Text="Audio, recognition and independent source routing" Margin="0,6,0,0" Foreground="#92A7BD"/>
  </StackPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="420"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
        <Border Background="#141D2A" CornerRadius="14" BorderBrush="#2C3A4D" BorderThickness="1" Padding="16" Margin="0,0,0,14">
   <StackPanel>
   <TextBlock Text="01   AUDIO INPUT" FontWeight="Bold" Foreground="#59E0C0" FontSize="11" Margin="0,0,0,13"/>
   <WrapPanel Margin="0,0,0,12">
    <StackPanel Margin="0,0,15,10">
     <TextBlock Text="Audio backend" Margin="0,0,0,5"/>
     <ComboBox x:Name="BackendBox" Width="145" SelectionChanged="SettingsChanged">
      <ComboBoxItem Content="ASIO"/>
      <ComboBoxItem Content="WDM / WASAPI"/>
     </ComboBox>
    </StackPanel>
    <StackPanel Margin="0,0,15,10">
     <TextBlock Text="Default AI profile" Margin="0,0,0,5"/>
     <ComboBox x:Name="ProfileBox" Width="155" SelectionChanged="SettingsChanged">
      <ComboBoxItem Content="Speed First"/>
      <ComboBoxItem Content="Balanced"/>
      <ComboBoxItem Content="Accuracy First"/>
     </ComboBox>
    </StackPanel>
    <StackPanel Margin="0,0,15,10">
     <TextBlock Margin="0,0,0,5">
       <TextBlock.Style>
        <Style TargetType="TextBlock">
         <Setter Property="Text" Value="Audio input device"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding SelectedIndex, ElementName=BackendBox}" Value="1">
           <Setter Property="Text" Value="Fallback audio device"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </TextBlock.Style>
      </TextBlock>
     <DockPanel>
      <Button DockPanel.Dock="Right" Content="Refresh" Padding="8,2" Margin="5,0,0,0" Click="RefreshDevicesClicked"/>
      <ComboBox x:Name="DeviceBox" Width="270" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="DeviceSelectionChanged" Foreground="#17202B" Background="White"/>
     </DockPanel>
    </StackPanel>
   </WrapPanel>
   </StackPanel></Border>

   <Border Background="#141D2A" CornerRadius="14" BorderBrush="#2C3A4D" BorderThickness="1" Padding="16" Margin="0,0,0,14">
    <StackPanel>
     <TextBlock Text="02   WEB VIEWER" FontWeight="Bold" Foreground="#59E0C0" FontSize="11" Margin="0,0,0,12"/>
     <CheckBox x:Name="WebEnabledBox" Content="Enable web UI" Checked="WebSettingsChanged" Unchecked="WebSettingsChanged" Margin="0,0,0,10"/>
     <TextBlock Text="Listening network interface" Margin="0,0,0,5"/>
     <ComboBox x:Name="WebInterfaceBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="WebSettingsChanged" Margin="0,0,0,10"/>
     <TextBlock Text="TCP port" Margin="0,0,0,5"/>
     <TextBox x:Name="WebPortBox" Width="110" HorizontalAlignment="Left" LostFocus="WebSettingsChanged" Margin="0,0,0,10"/>
     <TextBlock Text="Access permissions" Margin="0,0,0,5"/>
     <ComboBox x:Name="WebAccessBox" SelectionChanged="WebSettingsChanged" Margin="0,0,0,10">
      <ComboBoxItem Content="Read only (viewer)"/>
      <ComboBoxItem Content="Read/write (start and stop capture)"/>
     </ComboBox>
     <TextBlock Text="Access token (required)" Margin="0,0,0,5"/>
     <DockPanel Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="Regenerate" Click="RegenerateWebToken" Padding="8,3"/>
      <TextBox x:Name="WebTokenBox" IsReadOnly="True" Margin="0,0,6,0"/>
     </DockPanel>
     <TextBlock x:Name="WebStatus" TextWrapping="Wrap" Foreground="#92A7BD" FontSize="12"/>
     <TextBlock Text="HTTP is unencrypted. Use only on trusted LAN/VPN networks; never forward this port to the Internet." TextWrapping="Wrap" Foreground="#E7B87D" FontSize="11" Margin="0,8,0,0"/>
    </StackPanel>
   </Border>
   <Border Background="#141D2A" CornerRadius="14" BorderBrush="#2C3A4D" BorderThickness="1" Padding="16" Margin="0,0,0,14">
   <StackPanel>
   <TextBlock Text="03   RECOGNITION ENGINE" FontWeight="Bold" Foreground="#59E0C0" FontSize="11" Margin="0,0,0,13"/>
   <DockPanel Margin="0,0,0,12">
    <Button DockPanel.Dock="Right" Content="Refresh models" Click="RefreshModelsClicked" Padding="8,4" Margin="8,0,0,0"/>
    <StackPanel>
     <TextBlock Text="Recognition engine" Margin="0,0,0,5"/>
     <ComboBox x:Name="EngineBox" Width="220" HorizontalAlignment="Left" SelectionChanged="EngineChanged" Margin="0,0,0,8">
      <ComboBoxItem Content="Vosk — live"/>
      <ComboBoxItem Content="Whisper — local CPU"/>
      <ComboBoxItem Content="Groq — cloud Whisper"/>
     </ComboBox>
     <TextBlock Text="Recognition model" Margin="0,0,0,5"/>
     <ComboBox x:Name="ModelBox" DisplayMemberPath="Name" SelectedValuePath="Id"
        Width="370" HorizontalAlignment="Left" SelectionChanged="ModelChanged"/>
     <TextBlock Text="Groq API key (protected for your Windows account)" Margin="0,8,0,4"/>
     <PasswordBox x:Name="GroqKeyBox" Width="370" HorizontalAlignment="Left" PasswordChanged="GroqKeyChanged"/>
     <TextBlock Text="Cloud mode uploads gated speech audio. Offline engines never upload audio."
      Foreground="#93A6BB" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
    </StackPanel>
   </DockPanel>
   </StackPanel></Border>
   <WrapPanel Margin="0,0,0,12">
    <Button x:Name="StartCaptureButton" Style="{StaticResource PrimaryButton}" Content="▶  Start capture" Click="StartCaptureClicked" Padding="12,6" Margin="0,0,8,0"/>
    <Button x:Name="StopCaptureButton" Content="Stop" Click="StopCaptureClicked" Padding="12,6" Margin="0,0,8,0" IsEnabled="False"/>
   </WrapPanel>

        <TextBlock x:Name="DeviceStatus" Text="Scanning devices..." Foreground="#A0B0C0" Margin="0,0,0,12" TextWrapping="Wrap"/>

    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <DockPanel Margin="0,0,0,12">
    <Button DockPanel.Dock="Right" Content="+ Add source" Padding="10,5" Click="AddSourceClicked"/>
    <TextBlock Text="03   CHANNEL ROUTING &amp; PROCESSING" FontSize="13" Foreground="#59E0C0" FontWeight="Bold"/>
   </DockPanel>

    <Border Grid.Row="1" Background="#141D2A" CornerRadius="12" BorderBrush="#2C3A4D" BorderThickness="1" Padding="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
   <ItemsControl x:Name="SourcesList" AllowDrop="True" DragOver="SourcesDragOver" Drop="SourcesDrop">
    <ItemsControl.ItemTemplate>
     <DataTemplate>
      <Border Margin="0,0,0,7" Padding="12" Background="#182435" BorderBrush="#2D3D51" BorderThickness="1" CornerRadius="12">
       <StackPanel>
        <WrapPanel>
         <Border Background="#26384B" CornerRadius="5" Padding="8,3" Margin="0,0,10,0"
                 Cursor="SizeAll" Tag="{Binding Source}"
                 PreviewMouseLeftButtonDown="SourceGrabMouseDown" MouseMove="SourceGrabMouseMove"
                 ToolTip="Drag to reorder source">
          <TextBlock Text="☰" FontSize="19" Foreground="#59E0C0" IsHitTestVisible="False"/>
         </Border>
        <CheckBox Content="On" IsChecked="{Binding Source.Enabled, Mode=TwoWay}"
          Margin="0,7,12,0" Checked="SourceChanged" Unchecked="SourceChanged"/>
        <TextBox Width="195" Text="{Binding Source.Name, UpdateSourceTrigger=PropertyChanged}" TextChanged="SourceChanged"/>
        <TextBlock Text="Input #" VerticalAlignment="Center" Margin="8,0,8,0"/>
        <TextBox Width="55" Text="{Binding Source.InputNumber, Mode=OneWay}"
          TextChanged="SourceInputTextChanged" LostFocus="SourceInputLostFocus"/>
        <TextBlock Text="WASAPI device" VerticalAlignment="Center" Margin="10,0,6,0"/>
        <ComboBox Width="230" DisplayMemberPath="Name" SelectedValuePath="Id"
          ItemsSource="{Binding DataContext.WasapiDevices, RelativeSource={RelativeSource AncestorType=Window}}"
          SelectedValue="{Binding Source.WasapiDeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          SelectionChanged="SourceDeviceChanged"
          IsEnabled="{Binding IsEnabled, ElementName=StartCaptureButton}"
          Foreground="#17202B" Background="White"/>
        <Button Content="Remove source" Tag="{Binding Source}" Margin="15,0,0,0"
          Padding="8,4" Click="RemoveSourceClicked"/>
        </WrapPanel>
        <Expander Header="Color, gain and gate" Margin="0,10,0,3" Foreground="#D9E7F5" IsExpanded="False"><StackPanel><WrapPanel Margin="0,10,0,3">
         <TextBlock Text="Speaker color" Width="100" VerticalAlignment="Center"/>
         <Border Width="27" Height="27" CornerRadius="7" Background="{Binding ColorPreview}"
          BorderThickness="1" BorderBrush="#64748B" Margin="0,0,9,0"/>
         <Button Content="Pick color…" Tag="{Binding}" Click="PickSourceColorClicked" Padding="11,6" Margin="0,0,9,0"/>
         <TextBox Width="110" Text="{Binding Source.ColorHex, Mode=OneWay}" Tag="{Binding}"
          LostFocus="ColorHexLostFocus" ToolTip="Hex color: #RRGGBB"/>
         <TextBlock Text="#RRGGBB" FontSize="11" Foreground="#92A7BD" VerticalAlignment="Center"/>
        </WrapPanel>
        <TextBlock Text="{Binding ValidationMessage}" Foreground="#FF7777" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
        <DockPanel Margin="0,8,0,0">
         <TextBlock DockPanel.Dock="Left" Text="Digital gain" Width="85" VerticalAlignment="Center"/>
         <TextBlock DockPanel.Dock="Right" Text="{Binding Source.GainDb, StringFormat={}{0:+0;-0;0} dB}" Width="62" TextAlignment="Right" VerticalAlignment="Center"/>
         <Slider Minimum="-24" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
           Value="{Binding Source.GainDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="GainChanged"/>
        </DockPanel>
        <DockPanel Margin="0,8,0,0">
         <TextBlock DockPanel.Dock="Left" Text="Noise gate" Width="85" VerticalAlignment="Center"/>
         <TextBlock DockPanel.Dock="Right" Text="{Binding Source.GateDbfs, StringFormat={}{0:0} dBFS}" Width="75" TextAlignment="Right" VerticalAlignment="Center"/>
         <Slider Minimum="-80" Maximum="-20" TickFrequency="1" IsSnapToTickEnabled="True"
           Value="{Binding Source.GateDbfs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="GainChanged"/>
        </DockPanel>
       </StackPanel></Expander>
       <ProgressBar Minimum="0" Maximum="100" Value="{Binding Level}" Height="7" Margin="0,13,0,0" Foreground="#59E0C0" Background="#0F1720"/>
       </StackPanel>
      </Border>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>

    </Border>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Margin="0,12,0,0" Padding="0,4,0,0">  <TextBlock  Foreground="#A0B0C0" Margin="0,10,0,0"
    x:Name="CaptureStatus" Text="Ready • channel meters activate when capture starts"/>
</Border>
 </Grid>
</Window>
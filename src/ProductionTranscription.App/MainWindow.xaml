<Window x:Class="ProductionTranscription.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Production Transcription" Width="860" Height="720"
 MinWidth="360" MinHeight="220" Background="#141A22" Foreground="#F2F5FA"
 WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F2F5FA"/></Style>
 </Window.Resources>
 <DockPanel Margin="14">
  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
   <StackPanel DockPanel.Dock="Left">
    <TextBlock Text="PRODUCTION TRANSCRIPTION" FontSize="19" FontWeight="SemiBold"/>
    <TextBlock Text="Live production conversation" Foreground="#A0B0C0" FontSize="12"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="StartButton" Content="Start" Padding="12,6" Margin="6,0,0,0" Click="StartClicked"/>
    <Button x:Name="StopButton" Content="Stop" Padding="12,6" Margin="6,0,0,0" Click="StopClicked"/>
    <Button Content="⚙ Settings" Padding="12,6" Margin="6,0,0,0" Click="SettingsClicked"/>
   </StackPanel>
  </DockPanel>
  <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Text="Ready • offline session" FontSize="11"
   TextWrapping="Wrap" Foreground="#A0B0C0" Margin="0,8,0,0"/>
  <ListBox x:Name="ChatList" Background="#171F2A" BorderThickness="0"
   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
   ScrollViewer.VerticalScrollBarVisibility="Auto">
   <ListBox.ItemContainerStyle>
    <Style TargetType="ListBoxItem">
     <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
     <Setter Property="Padding" Value="0"/>
     <Setter Property="Margin" Value="0,4,0,4"/>
    </Style>
   </ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate>
    <DataTemplate>
     <Border Background="#222F40" Padding="12" CornerRadius="10" MaxWidth="780" HorizontalAlignment="Stretch">
      <StackPanel>
       <DockPanel Margin="0,0,0,6">
        <TextBlock Text="{Binding Source}" Foreground="{Binding Accent}" FontWeight="Bold" FontSize="12"/>
        <TextBlock Text="{Binding Time}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#98AABD" FontSize="11"/>
       </DockPanel>
       <TextBlock Text="{Binding Words}" TextWrapping="Wrap" FontSize="15" Foreground="#F2F5FA"/>
       <TextBlock Text="{Binding State}" FontSize="11" Foreground="#96A6B8" FontStyle="Italic"/>
      </StackPanel>
     </Border>
    </DataTemplate>
   </ListBox.ItemTemplate>
  </ListBox>
 </DockPanel>
</Window>
<Window x:Class="ProductionTranscription.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:svc="clr-namespace:ProductionTranscription.App.Services"
 Title="Production Transcription" Width="1040" Height="760" MinWidth="570" MinHeight="420"
 WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}">
 <Grid Margin="22">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,22">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Border Background="#153F3D" Width="45" Height="45" CornerRadius="13" Margin="0,0,14,0">
     <TextBlock Text="◉" FontSize="25" Foreground="#59E0C0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="PRODUCTION" Foreground="#59E0C0" FontWeight="Bold" FontSize="10"/>
     <TextBlock Text="Transcription" Foreground="#F3F8FE" FontWeight="SemiBold" FontSize="25"/>
    </StackPanel>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="▶  Start listening" Margin="0,0,8,0" Click="StartClicked"/>
    <Button x:Name="StopButton" Content="■  Stop" Margin="0,0,8,0" Click="StopClicked"/>
    <Button Content="⚙  Settings" Click="SettingsClicked"/>
   </StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="#141D2A" BorderBrush="#29394A" BorderThickness="1"
   CornerRadius="12" Padding="13,11" Margin="0,0,0,14">
   <DockPanel LastChildFill="True">
    <Border Width="7" Height="7" CornerRadius="4" Background="#59E0C0" DockPanel.Dock="Left" Margin="0,0,11,0" VerticalAlignment="Center"/>
    <TextBlock Text="LIVE TRANSCRIPT" DockPanel.Dock="Left" Foreground="#C8D7E7" FontSize="11" FontWeight="Bold"
     VerticalAlignment="Center" Margin="0,0,16,0"/>
    <TextBlock Text="MULTI-CHANNEL  /  SESSION VIEW" Foreground="#7D91A9" FontSize="10" VerticalAlignment="Center"
      HorizontalAlignment="Right"/>
   </DockPanel>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#151B29" BorderBrush="#2B394B" BorderThickness="1" CornerRadius="13" Margin="0,0,10,0">
    <DockPanel>
     <TextBlock Text="CHANNELS" DockPanel.Dock="Top" FontSize="11" Foreground="#91A5BC"
       FontWeight="Bold" Margin="14,15,0,12"/>
     <ListBox x:Name="ChannelList" Background="Transparent" BorderThickness="0"
      Foreground="#F3F6FD" SelectionChanged="ChannelSelectionChanged">
      <ListBox.ItemContainerStyle>
       <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="9,10"/>
        <Setter Property="Margin" Value="5,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Style.Triggers><Trigger Property="IsSelected" Value="True">
         <Setter Property="Background" Value="#303A4B"/>
        </Trigger></Style.Triggers>
       </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
       <DataTemplate>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Border Width="23" Height="23" BorderBrush="{Binding Accent}" BorderThickness="2" CornerRadius="12">
          <TextBlock Text="●" Foreground="{Binding Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
         </Border>
         <StackPanel Grid.Column="1" Margin="6,0,0,0">
          <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#91A5BC"/>
         </StackPanel>
         <Button Grid.Column="2" Content="{Binding MuteLabel}" Tag="{Binding}"
          Click="MuteChannelClicked" Padding="7,4" FontSize="10" Margin="5,0,0,0"/>
        </Grid>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#151D2A" CornerRadius="12" Padding="12,10" Margin="0,0,0,8">
     <TextBlock x:Name="ViewTitle" Text="All communications" FontSize="13" FontWeight="SemiBold"/>
    </Border>
  <Border Grid.Row="1" Background="#101824" BorderBrush="#283749" BorderThickness="1" CornerRadius="16">
   <ListBox x:Name="ChatList" Margin="8" Background="Transparent" BorderThickness="0" Foreground="#F2F6FC"
    ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
    <ListBox.ItemContainerStyle>
     <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="4,4,4,7"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers>
       <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/></Trigger>
      </Style.Triggers>
     </Style>
    </ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate>
     <DataTemplate>
      <Border Background="Transparent" BorderThickness="0" Padding="10,7"
       MaxWidth="900" HorizontalAlignment="Stretch">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{Binding Accent}" CornerRadius="3" Margin="0,1,0,1"/>
        <StackPanel Grid.Column="1" Margin="13,0,0,0">
         <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Source}" Foreground="{Binding Accent}" FontWeight="Bold" FontSize="13"/>
          <TextBlock Grid.Column="1" Text="{Binding Time}" Foreground="#899DB5" FontSize="11"/>
         </Grid>
         <TextBlock svc:CensoredText.Text="{Binding Words}" svc:CensoredText.Filter="{Binding Filter}"
          TextWrapping="Wrap" FontSize="16" LineHeight="24" Foreground="#F1F6FD"/>
         <TextBlock Text="{Binding State}" Foreground="#59E0C0" FontSize="11" Margin="0,7,0,0" FontStyle="Italic"/>
        </StackPanel>
       </Grid>
      </Border>
     </DataTemplate>
    </ListBox.ItemTemplate>
   </ListBox>
  </Border>
   </Grid>
  </Grid>
  <Grid Grid.Row="3" Margin="2,14,2,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="StatusText" Text="Ready · awaiting capture" Foreground="#9BADC1"
    FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
   <TextBlock Grid.Column="1" Text="LOCAL / CLOUD READY" Foreground="#617991" FontSize="10" VerticalAlignment="Center"/>
  </Grid>
 </Grid>
</Window>
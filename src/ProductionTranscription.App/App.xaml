<Application x:Class="ProductionTranscription.App.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="MessageText" Color="#F1F6FD"/>
  <SolidColorBrush x:Key="MessageSecondary" Color="#899DB5"/>
  <SolidColorBrush x:Key="Canvas" Color="#0B1019"/>
  <SolidColorBrush x:Key="Panel" Color="#141D2A"/>
  <SolidColorBrush x:Key="PanelRaised" Color="#1B2737"/>
  <SolidColorBrush x:Key="Edge" Color="#2B394B"/>
  <SolidColorBrush x:Key="Muted" Color="#94A5BC"/>
  <SolidColorBrush x:Key="Accent" Color="#59E0C0"/>
  <Style TargetType="Window">
   <Setter Property="FontFamily" Value="Segoe UI"/>
   <Setter Property="Background" Value="{StaticResource Canvas}"/>
   <Setter Property="Foreground" Value="#F2F6FC"/>
   <Setter Property="UseLayoutRounding" Value="True"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EDF4FF"/>
   <Setter Property="Background" Value="{StaticResource PanelRaised}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="16,9"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
       BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#2C4257"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.75"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.35"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{StaticResource Accent}"/>
   <Setter Property="Foreground" Value="#061E1B"/>
   <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#EAF0F7"/>
   <Setter Property="Foreground" Value="#122233"/>
   <Setter Property="BorderBrush" Value="#4A6077"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="9,7"/>
   <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style TargetType="PasswordBox">
   <Setter Property="Background" Value="#EAF0F7"/>
   <Setter Property="Foreground" Value="#122233"/>
   <Setter Property="BorderBrush" Value="#4A6077"/>
   <Setter Property="Padding" Value="9,7"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Background" Value="#EAF0F7"/>
   <Setter Property="Foreground" Value="#152335"/>
   <Setter Property="BorderBrush" Value="#4A6077"/>
   <Setter Property="Padding" Value="6,5"/>
   <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DAE6F3"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="Slider"><Setter Property="Foreground" Value="{StaticResource Accent}"/></Style>
  <Style TargetType="ProgressBar"><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="Background" Value="#0D1420"/></Style>
 </Application.Resources>
</Application>